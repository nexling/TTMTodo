[Unit]
Description=TTM-Todo inbox
After=network.target

[Service]
Type=simple
WorkingDirectory=/mnt/Websites/MagicTODO
EnvironmentFile=/mnt/Websites/MagicTODO/.env
ExecStart=/mnt/Websites/MagicTODO/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8010 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
