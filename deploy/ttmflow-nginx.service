[Unit]
Description=TTMFlow nginx (flow.takttimemodular.com + todo.takttimemodular.com)
After=network-online.target
Wants=network-online.target

[Service]
Type=forking
PIDFile=/mnt/Websites/TTMFlow/ifc-pipeline/nginx/logs/nginx.pid
WorkingDirectory=/mnt/Websites/TTMFlow/ifc-pipeline/nginx
ExecStartPre=/usr/sbin/nginx -p /mnt/Websites/TTMFlow/ifc-pipeline/nginx -c /mnt/Websites/TTMFlow/ifc-pipeline/nginx/conf/nginx.conf -t
ExecStart=/usr/sbin/nginx -p /mnt/Websites/TTMFlow/ifc-pipeline/nginx -c /mnt/Websites/TTMFlow/ifc-pipeline/nginx/conf/nginx.conf
ExecReload=/usr/sbin/nginx -p /mnt/Websites/TTMFlow/ifc-pipeline/nginx -c /mnt/Websites/TTMFlow/ifc-pipeline/nginx/conf/nginx.conf -s reload
ExecStop=/usr/sbin/nginx -p /mnt/Websites/TTMFlow/ifc-pipeline/nginx -c /mnt/Websites/TTMFlow/ifc-pipeline/nginx/conf/nginx.conf -s quit
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
