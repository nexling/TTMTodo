# Copy to .env and edit. Used by uvicorn and the systemd unit.
SECRET_KEY=change-me-to-a-long-random-string
PORT=8010
HOST=127.0.0.1

# Set true when served over HTTPS (nginx). Secure cookies on HTTPS only;
# http://127.0.0.1 still works for the SSH OAuth tunnel.
SESSION_HTTPS_ONLY=true

# Optional: create the first user on startup if the database is empty and Auth0 is off.
# If left unset, use the /setup page in the browser instead.
# MAGICTODO_USER=emilj
# MAGICTODO_PASSWORD=choose-a-strong-password

# Auth0 (Regular Web Application). When domain + client id + secret are set, password
# login is replaced by Auth0. Without Auth0, use /setup and /login locally.
# Callback URLs in the Auth0 app:
#   https://todo.takttimemodular.com/callback
#   http://127.0.0.1:8010/callback
# Logout return: https://todo.takttimemodular.com/  and http://127.0.0.1:8010/
# AUTH0_ENABLED=true
# AUTH0_DOMAIN=
# AUTH0_CLIENT_ID=
# AUTH0_CLIENT_SECRET=
# AUTH0_SCOPE=openid profile email
# SITE_ADMIN_EMAILS=you@example.com

# URL shown in API token curl examples.
PUBLIC_URL=https://todo.takttimemodular.com

# reMarkable SSH (tablet on Wi-Fi/Tailscale). Leave HOST empty to disable.
# Create a folder named TTM-Todo on the tablet; pages there become Inbox items.
# REMARKABLE_HOST=remarkable
# REMARKABLE_USER=root
# REMARKABLE_SSH_PORT=21
# REMARKABLE_SSH_KEY=/home/emilj/.ssh/id_ed25519
# REMARKABLE_FOLDER=TTM-Todo
# REMARKABLE_OUT_FOLDER=From TTM-Todo

# Google Tasks OAuth (voice dump via Tasks). Keep uses a separate master token in Settings.
# Enable the Tasks API. OAuth client type must be Web application.
# Authorized redirect URI (HTTP is only allowed on loopback — not Tailscale http://):
#   http://127.0.0.1:8010/api/google/callback
# Optional after Tailscale Serve HTTPS:
#   https://nexserve.tail18d09c.ts.net/api/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Optional override if the browser origin does not match (must still be loopback HTTP or HTTPS):
# GOOGLE_REDIRECT_URI=http://127.0.0.1:8010/api/google/callback

# Outlook / Microsoft Graph (read-only calendar overlay). App registration:
# Accounts: personal + work/school. Web redirect URIs:
#   http://127.0.0.1:8010/api/outlook/callback
#   https://your-public-host/api/outlook/callback
# Permissions: Calendars.Read, User.Read, offline_access (delegated).
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT=common
# Optional override:
# MICROSOFT_REDIRECT_URI=http://127.0.0.1:8010/api/outlook/callback

# SMTP for plan due-date emails (leave SMTP_HOST empty to disable sending).
# SMTP_HOST=mail.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=todo@example.com
# SMTP_STARTTLS=true
# SMTP_SSL=false
# MAIL_TIMEZONE=Europe/Stockholm
